    "Swipe left on a guest to remove them with everything recorded under them. You cannot be removed." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Плъзни наляво върху гост, за да го премахнеш с всичко, записано за него. Ти не можеш да бъдеш премахнат."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Přejeď u hosta doleva, chceš-li ho odebrat se vším, co je u něj zaznamenáno. Tebe odebrat nelze."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stryg til venstre på en gæst for at fjerne dem med alt, der er registreret under dem. Du kan ikke fjernes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wische bei einem Gast nach links, um ihn mit allem zu entfernen, was unter ihm aufgezeichnet wurde. Du selbst kannst nicht entfernt werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Σύρε αριστερά σε έναν επισκέπτη για να τον αφαιρέσεις μαζί με ό,τι έχει καταγραφεί για εκείνον. Εσύ δεν μπορείς να αφαιρεθείς."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe left on a guest to remove them with everything recorded under them. You cannot be removed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Desliza a la izquierda sobre un invitado para eliminarlo con todo lo registrado bajo su nombre. A ti no se te puede eliminar."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Libista külalise real vasakule, et ta koos kõige tema all salvestatuga eemaldada. Sind eemaldada ei saa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pyyhkäise vierasta vasemmalle poistaaksesi hänet ja kaiken hänelle kirjatun. Sinua ei voi poistaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Balaie vers la gauche sur un invité pour le retirer avec tout ce qui a été enregistré sous son nom. Tu ne peux pas être retiré."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Svaidhpeáil ar chlé ar aoi chun é a bhaint le gach rud a taifeadadh faoi. Ní féidir tusa a bhaint."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Povuci ulijevo na gostu da ga ukloniš sa svime što je zabilježeno pod njim. Tebe se ne može ukloniti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Húzd balra a vendéget, hogy eltávolítsd mindennel együtt, amit alatta rögzítettünk. Téged nem lehet eltávolítani."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Scorri a sinistra su un ospite per rimuoverlo con tutto ciò che è stato registrato a suo nome. Tu non puoi essere rimosso."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Braukite kairėn ant svečio, kad pašalintumėte jį su viskuo, kas jam užfiksuota. Jūsų pašalinti negalima."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pavelc pa kreisi uz viesa, lai noņemtu viņu ar visu, kas ierakstīts zem viņa. Tevi noņemt nevar."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Iswajpja lejn ix-xellug fuq mistieden biex tneħħih ma' kulma ġie rreġistrat taħtu. Int ma tistax titneħħa."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Veeg naar links op een gast om hen te verwijderen met alles wat onder hen is geregistreerd. Jij kunt niet worden verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Przesuń gościa w lewo, aby usunąć go wraz ze wszystkim, co pod nim zapisano. Ciebie nie można usunąć."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Desliza para a esquerda sobre um convidado para o remover com tudo o que foi registado em seu nome. Tu não podes ser removido."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Glisează la stânga pe un invitat pentru a-l elimina cu tot ce a fost înregistrat pentru el. Tu nu poți fi eliminat."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Potiahni hosťa doľava, ak ho chceš odstrániť so všetkým, čo je pri ňom zaznamenané. Teba odstrániť nemožno."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Podrsaj levo na gostu, da ga odstraniš z vsem, kar je zabeleženo pod njim. Tebe ni mogoče odstraniti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Svep åt vänster på en gäst för att ta bort hen med allt som registrerats under hen. Du kan inte tas bort."
          }
        }
      }
    },
