    "Never use this to decide whether you can drive. The app estimates, it does not measure, and your actual level can differ considerably." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Никога не решавай по това дали можеш да шофираш. Приложението оценява, а не измерва, и действителното ти ниво може да се различава значително."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nikdy podle toho nerozhoduj, jestli můžeš řídit. Aplikace odhaduje, neměří, a tvoje skutečná hladina se může výrazně lišit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Brug aldrig dette til at afgøre, om du kan køre. Appen skønner, den måler ikke, og dit faktiske niveau kan afvige betydeligt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Entscheide niemals anhand dieser App, ob du fahren kannst. Die App schätzt, sie misst nicht, und dein tatsächlicher Wert kann erheblich abweichen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Μην αποφασίζεις ποτέ με βάση αυτό αν μπορείς να οδηγήσεις. Η εφαρμογή εκτιμά, δεν μετρά, και το πραγματικό σου επίπεδο μπορεί να διαφέρει σημαντικά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Never use this to decide whether you can drive. The app estimates, it does not measure, and your actual level can differ considerably."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nunca uses esto para decidir si puedes conducir. La app estima, no mide, y tu nivel real puede ser muy distinto."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ära kunagi otsusta selle põhjal, kas võid autot juhtida. Äpp hindab, mitte ei mõõda, ja sinu tegelik tase võib märkimisväärselt erineda."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Älä koskaan päätä tämän perusteella, voitko ajaa. Sovellus arvioi, se ei mittaa, ja todellinen tasosi voi poiketa huomattavasti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ne te fie jamais à cette app pour décider si tu peux conduire. Elle estime, elle ne mesure pas, et ton taux réel peut être très différent."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ná húsáid é seo riamh chun cinneadh a dhéanamh an féidir leat tiomáint. Déanann an aip meastachán, ní thomhaiseann sí, agus d’fhéadfadh do leibhéal iarbhír a bheith an-difriúil."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nikad na temelju ovoga ne odlučuj smiješ li voziti. Aplikacija procjenjuje, ne mjeri, a tvoja stvarna razina može se znatno razlikovati."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soha ne ez alapján döntsd el, hogy vezethetsz-e. Az app nem mér, hanem becsül, és a valódi érték ettől jelentősen eltérhet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Non usare mai questa app per decidere se puoi guidare. L’app stima, non misura, e il tuo livello reale può essere molto diverso."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Niekada pagal tai nespręsk, ar gali vairuoti. Programėlė vertina, o ne matuoja, ir tavo tikrasis lygis gali labai skirtis."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nekad neizlem pēc šī, vai drīksti vadīt auto. Lietotne aplēš, nevis mēra, un tavs patiesais līmenis var būtiski atšķirties."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Qatt tuża dan biex tiddeċiedi jekk tistax issuq. L-app tistma, ma tkejjilx, u l-livell reali tiegħek jista’ jkun differenti ħafna."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gebruik dit nooit om te beslissen of je kunt rijden. De app schat, hij meet niet, en je werkelijke waarde kan flink afwijken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nigdy nie decyduj na tej podstawie, czy możesz prowadzić. Aplikacja szacuje, a nie mierzy, a twój rzeczywisty poziom może się znacznie różnić."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nunca uses isto para decidir se podes conduzir. A app estima, não mede, e o teu nível real pode ser muito diferente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nu decide niciodată pe baza acestui lucru dacă poți conduce. Aplicația estimează, nu măsoară, iar nivelul tău real poate fi mult diferit."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nikdy podľa toho nerozhoduj, či môžeš šoférovať. Aplikácia odhaduje, nemeria, a tvoja skutočná hladina sa môže výrazne líšiť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nikoli se na podlagi tega ne odloči, ali lahko voziš. Aplikacija ocenjuje, ne meri, in tvoja dejanska raven se lahko precej razlikuje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Använd aldrig detta för att avgöra om du kan köra. Appen uppskattar, den mäter inte, och din verkliga nivå kan skilja sig avsevärt."
          }
        }
      }
    },
