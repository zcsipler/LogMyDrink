    "Leave the rate to the frequency question unless you have a measurement to match it against." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Остави скоростта на въпроса за честотата, освен ако нямаш измерване, с което да я сравниш."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rychlost nech na otázce o četnosti, pokud nemáš měření, se kterým bys ji mohl porovnat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lad hastigheden følge spørgsmålet om hyppighed, medmindre du har en måling at holde den op imod."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Überlass die Rate der Frage nach der Häufigkeit, es sei denn, du hast einen Messwert, an dem du sie ausrichten kannst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Άφησε τον ρυθμό στην ερώτηση συχνότητας, εκτός αν έχεις μέτρηση για να τον συγκρίνεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave the rate to the frequency question unless you have a measurement to match it against."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Deja la tasa a la pregunta de frecuencia, salvo que tengas una medición con la que contrastarla."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jäta kiirus sageduse küsimuse hooleks, kui sul pole mõõtmist, millega seda võrrelda."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Anna juomistiheyttä koskevan kysymyksen määrittää nopeus, ellei sinulla ole mittausta, johon sitä verrata."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Laisse la vitesse à la question sur la fréquence, sauf si tu as une mesure à laquelle la comparer."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fág an ráta faoin gceist faoi mhinicíocht, mura bhfuil tomhas agat le hé a chur i gcomparáid leis."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Brzinu prepusti pitanju o učestalosti, osim ako imaš mjerenje s kojim je možeš usporediti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sebességet hagyd a gyakorisági kérdésre, hacsak nincs mért értéked, amihez igazítanád."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lascia la velocità alla domanda sulla frequenza, a meno che tu non abbia una misurazione con cui confrontarla."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Greitį palik dažnumo klausimui, nebent turi matavimą, su kuriuo jį galėtum palyginti."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Atstāj ātrumu biežuma jautājuma ziņā, ja vien tev nav mērījuma, ar ko to salīdzināt."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ħalli r-rata f'idejn il-mistoqsija dwar kemm-il darba tixrob, sakemm ma jkollokx kejl biex tqabbilha miegħu."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Laat de snelheid over aan de vraag hoe vaak je drinkt, tenzij je een meting hebt om hem mee te vergelijken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zostaw tempo pytaniu o częstotliwość, chyba że masz pomiar, z którym możesz je porównać."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Deixa a taxa à pergunta sobre a frequência, a menos que tenhas uma medição com que a comparar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lasă rata în seama întrebării despre frecvență, dacă nu ai o măsurătoare cu care s-o compari."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rýchlosť nechaj na otázke o frekvencii, ak nemáš meranie, s ktorým by si ju mohol porovnať."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hitrost prepusti vprašanju o pogostosti, razen če imaš meritev, s katero jo lahko primerjaš."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Låt frågan om hur ofta du dricker styra hastigheten, om du inte har en mätning att jämföra den med."
          }
        }
      }
    },
