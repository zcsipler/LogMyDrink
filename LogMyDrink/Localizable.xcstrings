        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ocena temelji na Widmarkovi metodi, s katero alkohol v krvi ocenjujejo od tridesetih let 20. stoletja; aplikacija uporablja njeno izboljšano različico."
          }
