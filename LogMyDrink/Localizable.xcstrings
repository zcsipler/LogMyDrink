    "Say “Hey Siri, LogMyDrink now” and Siri logs your favourite, then tells you where your peak is heading." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Кажи „Hey Siri, LogMyDrink now“ и Siri ще въведе любимата ти напитка и ще ти каже накъде отива върхът ти."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Řekni „Hey Siri, LogMyDrink now“ a Siri zapíše tvůj oblíbený nápoj a řekne ti, kam míří tvůj vrchol."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sig ”Hey Siri, LogMyDrink now”, så registrerer Siri din favorit og fortæller, hvor din top er på vej hen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sag „Hey Siri, LogMyDrink now“, und Siri erfasst dein Lieblingsgetränk und sagt dir, wohin dein Höchstwert geht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Πες «Hey Siri, LogMyDrink now» και η Siri καταγράφει το αγαπημένο σου και σου λέει πού πάει η κορύφωσή σου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Say “Hey Siri, LogMyDrink now” and Siri logs your favourite, then tells you where your peak is heading."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Di «Oye Siri, LogMyDrink now» y Siri registrará tu favorita y te dirá hacia qué pico vas."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ütle „Hey Siri, LogMyDrink now“ ja Siri lisab sinu lemmiku ning ütleb, kuhu su haripunkt liigub."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sano ”Hei Siri, LogMyDrink now”, niin Siri kirjaa suosikkisi ja kertoo, mihin huippusi on menossa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dis « Dis Siri, LogMyDrink now » : Siri enregistre ta favorite, puis t’indique vers quel pic tu vas."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Abair “Hey Siri, LogMyDrink now” agus cláróidh Siri an deoch is fearr leat, agus inseoidh sí duit cá bhfuil do bhuaic ag dul."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Reci „Hey Siri, LogMyDrink now” i Siri će unijeti tvoje omiljeno piće te reći kamo ide tvoj vrhunac."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mondd: „Hey Siri, LogMyDrink now”, és Siri felviszi a kedvencedet, majd megmondja, hová tart a csúcs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Di’ «Ehi Siri, LogMyDrink now»: Siri registra il tuo preferito e ti dice verso quale picco stai andando."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pasakyk „Hey Siri, LogMyDrink now“, ir Siri įrašys tavo mėgstamą gėrimą bei pasakys, kur link eina tavo pikas."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Saki „Hey Siri, LogMyDrink now“, un Siri pievienos tavu iecienīto dzērienu un pateiks, uz kurieni virzās tavs maksimums."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Għid “Hey Siri, LogMyDrink now” u Siri tirreġistra l-favorita tiegħek u tgħidlek lejn fejn sejra l-quċċata tiegħek."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zeg ‘Hé Siri, LogMyDrink now’ en Siri legt je favoriet vast en vertelt waar je piek naartoe gaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Powiedz „Hey Siri, LogMyDrink now”, a Siri zapisze ulubiony napój i powie, dokąd zmierza twój szczyt."
