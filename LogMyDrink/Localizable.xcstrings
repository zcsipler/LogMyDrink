    "History shows how much and how high you drink over weeks, months and years, and which way it is changing." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Историята показва колко и колко високо пиеш за седмици, месеци и години и в каква посока се променя това."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Historie ukazuje, kolik a jak vysoko piješ za týdny, měsíce a roky, a kterým směrem se to mění."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Historik viser, hvor meget og hvor højt du drikker over uger, måneder og år, og hvilken vej det går."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Verlauf zeigt, wie viel und wie hoch du über Wochen, Monate und Jahre trinkst – und wohin es sich entwickelt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Το Ιστορικό δείχνει πόσο και πόσο ψηλά πίνεις σε εβδομάδες, μήνες και χρόνια, και προς τα πού αλλάζει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "History shows how much and how high you drink over weeks, months and years, and which way it is changing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El historial muestra cuánto y hasta qué nivel bebes a lo largo de semanas, meses y años, y hacia dónde cambia."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ajalugu näitab, kui palju ja kui kõrgele sa nädalate, kuude ja aastate jooksul jood ning kuhu see muutub."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Historia näyttää, kuinka paljon ja kuinka korkealle juot viikkojen, kuukausien ja vuosien aikana, ja mihin suuntaan se muuttuu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L’historique montre combien et jusqu’à quel taux tu bois sur des semaines, des mois et des années, et comment cela évolue."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Taispeánann an Stair cé mhéad agus cé chomh hard a ólann tú thar sheachtainí, mhíonna agus bhlianta, agus cén treo ina bhfuil sé ag athrú."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Povijest prikazuje koliko i koliko visoko piješ kroz tjedne, mjesece i godine te u kojem se smjeru to mijenja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Előzményben hetekre, hónapokra és évekre látod, mennyit és milyen magasra iszol, és merre változik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La cronologia mostra quanto e fino a che livello bevi nell’arco di settimane, mesi e anni, e in che direzione cambia."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Istorija rodo, kiek ir kaip aukštai geri per savaites, mėnesius ir metus ir kuria kryptimi tai keičiasi."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vēsture rāda, cik daudz un cik augstu tu dzer nedēļu, mēnešu un gadu laikā un kurā virzienā tas mainās."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L-Istorja turi kemm u kemm għoli tixrob fuq ġimgħat, xhur u snin, u f’liema direzzjoni qed tinbidel."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Geschiedenis laat zien hoeveel en hoe hoog je drinkt over weken, maanden en jaren, en welke kant het op gaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Historia pokazuje, ile i jak wysoko pijesz na przestrzeni tygodni, miesięcy i lat, oraz w którą stronę to się zmienia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O histórico mostra quanto e até que nível bebes ao longo de semanas, meses e anos, e para onde está a mudar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
