    "If you log a drink after the fact, set the time back with the − and + buttons; a missed day can be filled in from the Day view in History." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ако въвеждаш напитка по-късно, върни часа назад с бутоните − и +; пропуснат ден може да се допълни от изгледа Ден в Историята."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Když zapisuješ nápoj dodatečně, posuň čas zpět tlačítky − a +; vynechaný den můžeš doplnit v zobrazení Den v Historii."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hvis du registrerer en drink bagefter, så stil tiden tilbage med knapperne − og +; en glemt dag kan udfyldes fra dagsvisningen i Historik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wenn du ein Getränk nachträglich erfasst, stell die Zeit mit − und + zurück; einen vergessenen Tag kannst du in der Tagesansicht des Verlaufs nachtragen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Αν καταγράφεις ένα ποτό εκ των υστέρων, γύρνα την ώρα πίσω με τα κουμπιά − και +· μια ξεχασμένη μέρα συμπληρώνεται από την προβολή Ημέρα του Ιστορικού."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you log a drink after the fact, set the time back with the − and + buttons; a missed day can be filled in from the Day view in History."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si registras una bebida después, retrasa la hora con los botones − y +; un día olvidado se puede completar desde la vista Día del historial."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kui sisestad joogi hiljem, keera aega tagasi nuppudega − ja +; vahele jäänud päeva saad täiendada Ajaloo päevavaates."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jos kirjaat juoman jälkikäteen, siirrä aikaa taaksepäin − ja + -painikkeilla; väliin jääneen päivän voit täydentää Historian päivänäkymästä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si tu enregistres un verre après coup, recule l’heure avec les boutons − et + ; une journée oubliée peut être complétée depuis la vue Jour de l’historique."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Má chláraíonn tú deoch ina dhiaidh sin, cuir an t-am siar leis na cnaipí − agus +; is féidir lá a cailleadh a líonadh ón amharc Lá sa Stair."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ako piće unosiš naknadno, vrati vrijeme gumbima − i +; propušteni dan možeš dopuniti u prikazu Dan u Povijesti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha egy italt utólag viszel fel, az időt a − és + gombokkal állítsd vissza; egy kimaradt napot az Előzmény Nap nézetében pótolhatsz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se registri un drink in un secondo momento, riporta indietro l’ora con i pulsanti − e +; un giorno dimenticato si può completare dalla vista Giorno della cronologia."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jei gėrimą įrašai vėliau, atsuk laiką atgal mygtukais − ir +; praleistą dieną gali papildyti Istorijos dienos rodinyje."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ja dzērienu pievieno vēlāk, pagriez laiku atpakaļ ar pogām − un +; izlaistu dienu vari papildināt Vēstures dienas skatā."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jekk tirreġistra xarba wara, ressaq il-ħin lura bil-buttuni − u +; ġurnata li qbiżt tista’ timliha mill-veduta Jum fl-Istorja."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Leg je een drankje achteraf vast, zet de tijd dan terug met de knoppen − en +; een vergeten dag kun je aanvullen vanuit de dagweergave in Geschiedenis."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jeśli zapisujesz napój później, cofnij godzinę przyciskami − i +; pominięty dzień możesz uzupełnić w widoku Dzień w Historii."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se registares uma bebida mais tarde, recua a hora com os botões − e +; um dia esquecido pode ser preenchido a partir da vista Dia do histórico."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dacă înregistrezi o băutură ulterior, dă ora înapoi cu butoanele − și +; o zi omisă poate fi completată din vizualizarea Zi din Istoric."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Keď zapisuješ nápoj dodatočne, posuň čas späť tlačidlami − a +; vynechaný deň môžeš doplniť v zobrazení Deň v Histórii."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Če pijačo vneseš naknadno, čas prestavi nazaj z gumboma − in +; izpuščen dan lahko dopolniš v dnevnem pogledu Zgodovine."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Om du loggar en dryck i efterhand, ställ tillbaka tiden med knapparna − och +; en missad dag kan fyllas i från dagsvyn i Historik."
          }
        }
      }
    },
