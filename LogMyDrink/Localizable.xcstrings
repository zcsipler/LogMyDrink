    "The estimate builds on the Widmark method, used to estimate blood alcohol since the 1930s; the app runs a refined version of it." : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Оценката се основава на метода на Видмарк, с който алкохолът в кръвта се оценява от 30-те години на XX век; приложението използва негова усъвършенствана версия."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Odhad vychází z Widmarkovy metody, kterou se hladina alkoholu v krvi odhaduje od 30. let 20. století; aplikace používá její vylepšenou verzi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skønnet bygger på Widmarks metode, som er brugt til at skønne alkoholpromillen siden 1930’erne; appen bruger en forfinet udgave af den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Schätzung beruht auf der Widmark-Methode, mit der der Blutalkohol seit den 1930er-Jahren geschätzt wird; die App verwendet eine verfeinerte Fassung davon."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Η εκτίμηση βασίζεται στη μέθοδο Widmark, που χρησιμοποιείται από τη δεκαετία του 1930 για την εκτίμηση του αλκοόλ στο αίμα· η εφαρμογή χρησιμοποιεί μια βελτιωμένη εκδοχή της."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The estimate builds on the Widmark method, used to estimate blood alcohol since the 1930s; the app runs a refined version of it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La estimación se basa en el método de Widmark, que se usa desde los años treinta para estimar la alcoholemia; la app emplea una versión refinada."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hinnang põhineb Widmarki meetodil, millega on vere alkoholisisaldust hinnatud alates 1930. aastatest; äpp kasutab selle täiustatud versiooni."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Arvio perustuu Widmarkin menetelmään, jolla veren alkoholipitoisuutta on arvioitu 1930-luvulta lähtien; sovellus käyttää siitä hiottua versiota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L’estimation repose sur la méthode de Widmark, utilisée depuis les années 1930 pour estimer l’alcoolémie ; l’app en utilise une version affinée."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tá an meastachán bunaithe ar mhodh Widmark, a úsáidtear ó na 1930idí chun alcól san fhuil a mheas; úsáideann an aip leagan scagtha de."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Procjena se temelji na Widmarkovoj metodi kojom se alkohol u krvi procjenjuje od 1930-ih; aplikacija koristi njezinu poboljšanu inačicu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A becslés alapja a Widmark-módszer, amellyel az 1930-as évek óta becsülik a véralkoholszintet; az app ennek egy továbbfejlesztett változatát használja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La stima si basa sul metodo di Widmark, usato dagli anni Trenta per stimare il tasso alcolemico; l’app ne usa una versione perfezionata."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Įvertis remiasi Widmarko metodu, kuriuo alkoholio koncentracija kraujyje vertinama nuo XX a. 4-ojo dešimtmečio; programėlė naudoja patobulintą jo versiją."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aplēse balstās uz Vidmarka metodi, ar kuru alkohola koncentrāciju asinīs aplēš kopš 20. gadsimta 30. gadiem; lietotne izmanto tās pilnveidotu versiju."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L-istima hija bbażata fuq il-metodu ta’ Widmark, użat mis-snin tletin biex jiġi stmat l-alkoħol fid-demm; l-app tuża verżjoni rfinata tiegħu."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De schatting is gebaseerd op de methode van Widmark, die sinds de jaren dertig wordt gebruikt om het bloedalcohol te schatten; de app gebruikt een verfijnde versie ervan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Szacunek opiera się na metodzie Widmarka, stosowanej od lat 30. XX wieku do szacowania stężenia alkoholu we krwi; aplikacja używa jej udoskonalonej wersji."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A estimativa baseia-se no método de Widmark, usado desde a década de 1930 para estimar a taxa de alcoolemia; a app usa uma versão aperfeiçoada."
          }
        },
        "ro" : {
          "stringUnit" : {
